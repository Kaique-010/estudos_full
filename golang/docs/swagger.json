{
    "swagger": "2.0",
    "info": {
        "description": "API de gerenciamento de clientes do sistema Vendas.",
        "title": "Vendas API - Go",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/cliente_documento": {
            "get": {
                "description": "Busca um cliente pelo CPF ou CNPJ.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Clientes"
                ],
                "summary": "Buscar cliente por documento",
                "parameters": [
                    {
                        "type": "string",
                        "description": "CPF ou CNPJ do cliente",
                        "name": "documento",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Cliente"
                        }
                    },
                    "400": {
                        "description": "Documento não fornecido",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Cliente não encontrado",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/clientes": {
            "get": {
                "description": "Retorna uma lista de todos os clientes cadastrados.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Clientes"
                ],
                "summary": "Listar todos os clientes",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Cliente"
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno do servidor",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/clientes_buscar_por_id": {
            "get": {
                "description": "Retorna um cliente com base no ID fornecido.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Clientes"
                ],
                "summary": "Buscar cliente por ID",
                "parameters": [
                    {
                        "type": "integer",
                        "format": "int64",
                        "description": "ID do cliente",
                        "name": "id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Cliente"
                        }
                    },
                    "400": {
                        "description": "ID não fornecido",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Cliente não encontrado",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Cliente": {
            "type": "object",
            "properties": {
                "ativo": {
                    "type": "boolean"
                },
                "cep": {
                    "type": "string"
                },
                "cidade": {
                    "type": "string"
                },
                "criado_em": {
                    "type": "string"
                },
                "documento": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "endereco": {
                    "type": "string"
                },
                "estado": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "nome": {
                    "type": "string"
                },
                "numero": {
                    "type": "string"
                },
                "telefone": {
                    "type": "string"
                }
            }
        }
    }
}